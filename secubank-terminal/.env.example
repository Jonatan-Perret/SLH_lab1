# Copy to .env and fill in the values.
KEYCLOAK_URL=http://localhost:7080
KEYCLOAK_REALM=secubank
KEYCLOAK_TERMINAL_CLIENT_ID=secubank-terminal
KEYCLOAK_SA_CLIENT_ID=secubank-terminal-service-account
# Secret of your service account client (Keycloak console: Clients ->
# secubank-terminal-service-account -> Credentials).
KEYCLOAK_SA_CLIENT_SECRET=
# Vault file, relative to secubank-terminal/. Copy vaults.example.toml to create or reset it.
VAULTS_PATH=vaults.toml
# Pinned realm signing key (Keycloak console: Realm settings -> Keys, RS256 row):
# the `Kid` and the `Public key` (base64, one line). Never fetched at runtime.
# Copy them again after `docker compose down -v` (the realm gets a new key),
# or run `keycloak/print-realm-key.sh` and paste its output here.
KEYCLOAK_REALM_KID=
KEYCLOAK_REALM_PUBLIC_KEY=
# Pepper for the dial-code hashes (`openssl rand -base64 32`).
# Warning: changing it invalidates every dial code.
DIAL_CODE_PEPPER=
